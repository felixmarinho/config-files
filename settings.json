  // ============================================================
  // Editor
  // ============================================================

  "editor.fontFamily": "'JetBrains Mono Nerd Font', 'monospace', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,
  "editor.letterSpacing": 0,

  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "editor.lineNumbers": "relative",

  "editor.fontLigatures": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,

  "editor.minimap.enabled": false,
  "editor.linkedEditing": true,
  "editor.smoothScrolling": true,

  "editor.cursorSurroundingLines": 8,
  "editor.hover.delay": 1000,

  "editor.lineDecorationsWidth": 10,
  "editor.glyphMargin": false,
  "editor.folding": false,

  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "files.autoSave": "off",

  // ============================================================
  // Terminal
  // ============================================================

  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontLigatures.enabled": true,

  "terminal.integrated.initialHint": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",

  "workbench.colorCustomizations": {
    "terminal.background": "#2c2f34",
    "terminal.foreground": "#2d2f34",
    "terminalCursor.foreground": "#9b9ea4",
    "terminal.selectionBackground": "#4f5258",
    "terminal.selectionForeground": "#e0e2ea",

    "terminal.ansiBlack": "#07080d",
    "terminal.ansiRed": "#ffc0b9",
    "terminal.ansiGreen": "#b3f6c0",
    "terminal.ansiYellow": "#fce094",
    "terminal.ansiBlue": "#a6dbff",
    "terminal.ansiMagenta": "#ffcaff",
    "terminal.ansiCyan": "#8cf8f7",
    "terminal.ansiWhite": "#eef1f8",

    "terminal.ansiBrightBlack": "#4f5258",
    "terminal.ansiBrightRed": "#ffc0b9",
    "terminal.ansiBrightGreen": "#b3f6c0",
    "terminal.ansiBrightYellow": "#fce094",
    "terminal.ansiBrightBlue": "#a6dbff",
    "terminal.ansiBrightMagenta": "#ffcaff",
    "terminal.ansiBrightCyan": "#8cf8f7",
    "terminal.ansiBrightWhite": "#eef1f8"
  },

  // ============================================================
  // Security
  // ============================================================

  "security.workspace.trust.untrustedFiles": "open",

  // ============================================================
  // VSCodeVim
  // ============================================================

  "vim.leader": "<space>",

  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,

  "vim.foldfix": true,
  "vim.surround": true,
  "vim.sneak": true,
  "vim.sneakUseIgnorecaseAndSmartcase": true,

  "vim.camelCaseMotion.enable": false,
  "vim.statusBarColorControl": false,

  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 200,

  // ============================================================
  // VSCodeVim — Key Handling
  // ============================================================

  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-z>": false,
    "<C-w>": false,
    "<C-p>": false
  },

  // ============================================================
  // VSCodeVim — Insert Mode
  // ============================================================

  "vim.insertModeKeyBindings": [
    {
      "before": ["<C-c>"],
      "after": ["<Esc>"]
    }
  ],

  // ============================================================
  // VSCodeVim — Normal Mode
  // ============================================================

  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["shift", ";"],
      "commands": ["vim.showQuickpickCmdLine"],
      "when": "editorTextFocus && vim.mode != 'Insert'"
    },
    {
      "before": ["<leader>", "n"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    {
      "before": ["<leader>", "r", "r"],
      "commands": ["editor.action.rename"]
    },
    {
      "before": ["<leader>", "r", "f"],
      "commands": ["fileutils.renameFile"]
    },
    {
      "before": ["<leader>", "p", "s"],
      "commands": ["fuzzySearch.activeTextEditor"]
    },
    {
      "before": ["J"],
      "after": ["o", "<Esc>", "k", "$"]
    },
    {
      "before": ["K"],
      "after": ["O", "<Esc>", "j", "$"]
    },
    {
      "before": ["L"],
      "commands": ["lineBreakInsert"],
      "silent": true
    }
  ],

  "vim.normalModeKeyBindings": [
    {
      "before": ["<C-n>"],
      "commands": [":nohl"]
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["£"],
      "after": ["#"]
    },
    {
      "before": ["<leader>", "f"],
      "commands": ["revealInExplorer"]
    },
    {
      "before": ["<leader>", "f", "y"],
      "commands": ["copyFilePath"]
    },
    {
      "before": ["<leader>", "f", "n"],
      "commands": ["explorer.newFile"]
    },
    {
      "before": ["<leader>", "c"],
      "commands": ["editor.action.commentLine"]
    },
    {
      "before": ["<leader>", "+"],
      "commands": ["workbench.action.increaseViewSize"]
    },
    {
      "before": ["<leader>", "-"],
      "commands": ["workbench.action.decreaseViewSize"]
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.view.explorer"]
    },

    // Focus editor groups
    {
      "before": ["<C-h>"],
      "commands": ["workbench.action.focusLeftGroup"]
    },
    {
      "before": ["<C-j>"],
      "commands": ["workbench.action.focusBelowGroup"]
    },
    {
      "before": ["<C-k>"],
      "commands": ["workbench.action.focusAboveGroup"]
    },
    {
      "before": ["<C-l>"],
      "commands": ["workbench.action.focusRightGroup"]
    },

    // Split editor
    {
      "before": ["|"],
      "after": ["<C-w>", "v"]
    },
    {
      "before": ["_"],
      "after": ["<C-w>", "s"]
    },

    // Git
    {
      "before": ["<leader>", "g", "p"],
      "commands": ["editor.action.dirtydiff.next"]
    },
    {
      "before": ["<leader>", "g", "r"],
      "commands": ["git.revertSelectedRanges"]
    }
  ],

  // ============================================================
  // VSCodeVim — Operator Pending
  // ============================================================

  "vim.operatorPendingModeKeyBindings": [
    {
      "before": ["L"],
      "after": ["$"]
    },
    {
      "before": ["H"],
      "after": ["^"]
    }
  ],

  // ============================================================
  // VSCodeVim — Visual Mode
  // ============================================================

  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["p"],
      "after": ["w", "g", "v", "y"]
    }
  ],

  "vim.visualModeKeyBindings": [
    {
      "before": ["n", "n"],
      "after": ["<Esc>"]
    },
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesUpAction"]
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesDownAction"]
    },

    // Comment selected lines
    {
      "before": ["<leader>", "c"],
      "commands": ["editor.action.commentLine", "extension.vim_escape"]
    },

    // Select all occurrences
    {
      "before": ["<leader>", "a"],
      "commands": ["editor.action.selectHighlights"]
    },

    // Sort selected lines
    {
      "before": ["<leader>", "s", "s"],
      "commands": ["editor.action.sortlinesascending"]
    },

    // Uppercase
    {
      "before": ["<leader>", "u"],
      "commands": ["editor.action.transformtouppercase"]
    },

    // Lowercase
    {
      "before": ["<leader>", "l"],
      "commands": ["editor.action.transformToLowercase"]
    }
  ],

  // ============================================================
  // VSCodeVim — macOS Input Method
  // ============================================================

  "vim.autoSwitchInputMethod.enable": true,
  "vim.autoSwitchInputMethod.defaultIM": "com.apple.keylayout.US",
  "vim.autoSwitchInputMethod.obtainIMCmd": "/usr/local/bin/im-select",
  "vim.autoSwitchInputMethod.switchIMCmd": "/usr/local/bin/im-select {im}",

  // ============================================================
  // Extensions
  // ============================================================

  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },

  "liveServer.settings.donotVerifyTags": true,
  "liveServer.settings.donotShowInfoMsg": true
}
