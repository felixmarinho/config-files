-- Kanagawa
local DarkGrayEyes = "#202023"
local DarkGrayEyesFloatBg = "#1a1a1e"
local NewCursorColor = "#e26c88"
local CursorLineColor = "#262628"
local LineNumbers = "#5d5d69"
local DimmedForeground = "#8f8f9f"
local FloatBorder = "#C0D0E0"
local MsgLineFgColor = "#bdbdcf"
local Whitespaces = "#313131"
local Selection = "#393d47"

return {
	"rebelot/kanagawa.nvim",
	config = function()
		require("kanagawa").setup({
			compile = true,
			-- transparent = true,
			background = {
				dark = "wave",
			},
			overrides = function(colors)
				return {
					["@markup.link.url.markdown_inline"] = { link = "Special" }, -- (url)
					["@markup.link.label.markdown_inline"] = { link = "WarningMsg" }, -- [label]
					["@markup.italic.markdown_inline"] = { link = "Exception" }, -- *italic*
					["@markup.raw.markdown_inline"] = { link = "String" }, -- `code`
					["@markup.list.markdown"] = { link = "Function" }, -- + list
					["@markup.quote.markdown"] = { link = "Error" }, -- > blockcode
					["@markup.list.checked.markdown"] = { link = "WarningMsg" }, -- - [X] checked list item

					["@property.json"] = { bold = false },
					["@string.json"] = { bold = false },
					["@number.json"] = { bold = false },
					["@boolean.json"] = { bold = false },
					["@constant.json"] = { bold = false },
					["@keyword.json"] = { bold = false },
					["@punctuation.bracket.json"] = { bold = false },
					["@keyword.operator"] = { link = "Keyword" },
					["@variable"] = { fg = "#D57780" },
					["@lsp.type.variable"] = { fg = "#D57780" },
					["@variable.parameter"] = { fg = "#D09470" },
					["@variable.member"] = { fg = "#81A1C1" },
					["@variable.builtin"] = { fg = "#B589D3" },

					-- Statements
					Statement = { bold = false },
					Boolean = { bold = false },
					Keyword = { bold = false },
					Type = { bold = false },
					Function = { bold = false },
					Constant = { fg = "#C0D0E0", bold = false },
					Identifier = { fg = "#C0D0E0", bold = false },
					Special = { bold = false },
					String = { bold = false },
					Comment = { bold = false },
					Number = { bold = false },
					Title = { bold = false },
					Operator = { bold = false },

					-- Normal BG
					Normal = {
						bg = "none",
					},
					-- Sign Column

					SignColumn = {
						bg = "none",
					},
					-- Fold Column
					FoldColumn = {
						bg = "none",
					},
					-- Sign column on the current line
					CursorLineSign = {
						bg = "none",
					},
					-- LSP Diagnostic Signs
					DiagnosticSignError = {
						fg = colors.palette.samuraiRed,
						bg = "none",
					},
					DiagnosticSignWarn = {
						fg = colors.palette.roninYellow,
						bg = "none",
					},
					DiagnosticSignInfo = {
						fg = colors.palette.dragonBlue,
						bg = "none",
					},
					DiagnosticSignHint = {
						fg = colors.palette.waveAqua1,
						bg = "none",
					},
					DiagnosticSignOk = {
						fg = colors.palette.springGreen,
						bg = "none",
					},
					-- Line number column
					LineNr = {
						fg = LineNumbers,
						bg = "none",
					},
					-- Current line number
					CursorLineNr = {
						bg = "none",
						bold = true,
					},
					-- Current line background
					CursorLine = {
						bg = CursorLineColor,
					},
					-- Current line background
					Cursor = {
						bg = NewCursorColor,
					},

					-- Non Text
					Whitespace = {
						fg = Whitespaces,
					},

					-- Color column
					ColorColumn = {
						bg = CursorLineColor,
					},
					-- Winsepator Color
					WinSeparator = {
						fg = DimmedForeground,
					},
					MsgArea = {
						fg = MsgLineFgColor,
						bg = "none",
					},

					MsgSeparator = {
						bg = "none",
					},
					ErrorMsg = {
						bg = "none",
					},
					WarningMsg = {
						bg = "none",
					},
					ModeMsg = {
						bg = "none",
					},
					MoreMsg = {
						bg = "none",
					},
					-- floating windows
					FloatBorder = {
						fg = FloatBorder,
						bg = "none",
					},

					NormalFloat = {
						bg = "none",
					},
					FloatTitle = {
						fg = MsgLineFgColor,
						bg = "none",
						-- bold = false,
					},
					Winbar = {
						fg = MsgLineFgColor,
						bg = "none",
						-- bold = false,
					},
					-- Tabline
					TabLine = {
						fg = DimmedForeground,
						bg = "none",
					},

					TabLineFill = {
						bg = "none",
					},

					TabLineSel = {
						fg = MsgLineFgColor,
						bg = "none",
						bold = false,
					},
					WinBarNC = {
						bg = "none",
						-- bold = false,
					},
					Visual = {
						bg = Selection,
						-- bold = false,
					},
					VisualNOS = {
						bg = Selection,
						-- bold = false,
					},
					Search = {
						bg = "#383c98",
						-- bold = false,
					},
					IncSearch = {
						bg = "#f8fc88",
						-- bold = false,
					},
					CurSearch = {
						bg = "#c83c93",
						-- bold = false,
					},
					FzfLuaCustomBorder = {
						fg = FloatBorder,
						-- bg = "none",
					},
					fzfluaBackdrop = {
						bg = "#000000",
					},
					-- Gitsigns: match sign backgrounds to the editor
					GitSignsAdd = {
						-- fg = colors.palette.autumnGreen,
						bg = "none",
					},
					GitSignsChange = {
						-- fg = colors.palette.waveAqua1,
						bg = "none",
					},
					GitSignsDelete = {
						-- fg = colors.palette.autumnRed,
						bg = "none",
					},
					GitSignsChangedelete = {
						-- fg = colors.palette.waveAqua1,
						bg = "none",
					},
					GitSignsTopdelete = {
						-- fg = colors.palette.autumnRed,
						bg = "none",
					},
					GitSignsUntracked = {
						-- fg = colors.palette.autumnGreen,
						bg = "none",
					},
				}
			end,
		})
		vim.cmd("colorscheme kanagawa")
	end,
	build = function()
		vim.cmd("KanagawaCompile")
	end,
}
