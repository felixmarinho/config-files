#---------------------------------------------------------
# Window General Settings
#---------------------------------------------------------
 
  macos-titlebar-style = hidden
  macos-non-native-fullscreen = true
  
  window-save-state = always
  confirm-close-surface = false

  window-padding-x = 10
  window-padding-balance = true

#---------------------------------------------------------
# Ghostty Icon
#---------------------------------------------------------

  macos-icon = custom-style
  macos-icon-frame = plastic
  macos-icon-ghost-color = #42FF9D
  macos-icon-screen-color = #000000

#---------------------------------------------------------
# Quick Terminal
#---------------------------------------------------------
 
  keybind = global:opt+grave_accent=toggle_quick_terminal
  quick-terminal-screen = main
  quick-terminal-position = top

#---------------------------------------------------------
# Themes
#---------------------------------------------------------

# theme = Raycast Dark
  theme = Nvim Dark
# theme = Later This Evening

# Overrides

  background = #282c34 
  foreground = #adadc0

#---------------------------------------------------------
# Fonts
#---------------------------------------------------------
 
  font-family = JetBrains Mono Light
  font-family-bold = JetBrains Mono Bold
  font-family-italic = JetBrains Mono Italic
  font-family-bold-italic = JetBrains Mono Bold Italic

  font-size = 15
  window-inherit-font-size = true
  font-thicken = true
# adjust-cell-width = 5%

#---------------------------------------------------------
# Cursor Style
#---------------------------------------------------------

# cursor-style = underline
  cursor-style-blink = true

#---------------------------------------------------------
# Clipboard
#---------------------------------------------------------
 
  copy-on-select = clipboard
