{
  // Workbench

  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.labelFormat": "medium",
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.sideBar.location": "left",
  "workbench.activityBar.location": "top",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 19,

  "window.density.editorTabHeight": "compact",
  "window.nativeTabs": true,
  "window.menuBarVisibility": "classic",
  "workbench.productIconTheme": "vscode.vscode-theme-seti",

  // Editor

  "editor.renderLineHighlight": "line",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,

  "editor.fontFamily": "'jetbrainsmono nfm', thin",
  "editor.fontSize": 20,
  "editor.lineHeight": 1.3,
  "editor.letterSpacing": 0,

  "editor.tabSize": 4,
  "editor.wordWrap": "off",
  "editor.lineNumbers": "relative",

  "editor.fontLigatures": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": false,

  "editor.minimap.enabled": false,
  "editor.linkedEditing": true,
  "editor.smoothScrolling": true,

  "editor.cursorSurroundingLines": 10,
  "editor.hover.delay": 1000,

  "editor.lineDecorationsWidth": 10,
  "editor.glyphMargin": false,
  "editor.folding": false,

  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "files.autoSave": "off",
  "flash-vscode.labelKeys": "abcdefghijklmnopqrstuvwxyz",

  // Terminal
  "find-it-faster.general.useTerminalInEditor": true,
  "terminal.integrated.fontFamily": "'jetbrainsmono nfm', thin",
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.fontLigatures.enabled": true,

  "terminal.integrated.initialHint": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",

  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#e26c88",
    "editor.background": "#201f23",
    "sideBar.background": "#201f23",
    "panel.background": "#201f23",
    "titleBar.activeBackground": "#201f23",
    "titleBar.inactiveBackground": "#201f23",
    "titleBar.activeForeground": "#adadc0",
    "titleBar.inactiveForeground": "#adadc0",
    "titleBar.border": "#201f23",
    "editorGroupHeader.tabsBackground": "#201f23",
    "editorGroupHeader.noTabsBackground": "#201f23",
    "editorGroup.emptyBackground": "#201f23",
    "editorGroup.dropBackground": "#201f23",
    "editorGroupHeader.border": "#201f23",
    "tab.activeBackground": "#201f23",
    "tab.inactiveBackground": "#201f23",
    "tab.unfocusedActiveBackground": "#201f23",
    "statusBar.background": "#005f5f",
    "statusBar.noFolderBackground": "#005f5f",
    "statusBar.debuggingBackground": "#005f5f",
    "statusBar.foreground": "#ffffff",
    "activityBar.background": "#201f23",
    "activityBar.activeBackground": "#201f23",
    "activityBar.inactiveForeground": "#adadc0",
    "activityBar.foreground": "#adadc0",
    "activityBar.activeBorder": "#201f23",
    "activityBarTop.background": "#201f23",
    "activityBarTop.activeBackground": "#201f23",
    "activityBarTop.activeBorder": "#201f23",
    "activityBarTop.foreground": "#adadc0",
    "activityBarTop.inactiveForeground": "#adadc0",
    "sideBarSectionHeader.background": "#201f23",
    "sideBarSectionHeader.foreground": "#adadc0",
    "sideBarSectionHeader.border": "#201f23",
    "editorWidget.background": "#201f23",
    "editorWidget.foreground": "#adadc0",
    "editorWidget.border": "#2A2A37",
    "widget.border": "#2A2A37",
    "widget.shadow": "#16161D80",
    "input.background": "#201f23",
    "input.foreground": "#adadc0",
    "input.border": "#2A2A37",
    "input.placeholderForeground": "#727169",
    "inputOption.activeBackground": "#262628",
    "inputOption.activeForeground": "#DCD7BA",
    "inputOption.activeBorder": "#54546D",
    "inputOption.hoverBackground": "#262628",
    "menu.background": "#201f23",
    "menu.foreground": "#adadc0",
    "menu.selectionBackground": "#262628",
    "menu.selectionForeground": "#DCD7BA",
    "menu.selectionBorder": "#262628",
    "menubar.selectionBackground": "#262628",
    "menubar.selectionForeground": "#DCD7BA",
    "dropdown.background": "#201f23",
    "dropdown.foreground": "#adadc0",
    "dropdown.listBackground": "#201f23",
    "dropdown.border": "#2A2A37",
    "quickInput.background": "#201f23",
    "quickInput.foreground": "#adadc0",
    "quickInputList.focusBackground": "#262628",
    "quickInputList.focusForeground": "#DCD7BA",
    "quickInputTitle.background": "#201f23",
    "pickerGroup.foreground": "#727169",
    "pickerGroup.border": "#2A2A37",
    "list.activeSelectionBackground": "#262628",
    "list.activeSelectionForeground": "#DCD7BA",
    "list.inactiveSelectionBackground": "#262628",
    "list.inactiveSelectionForeground": "#DCD7BA",
    "list.focusBackground": "#262628",
    "list.focusForeground": "#DCD7BA",
    "list.hoverBackground": "#262628",
    "settings.dropdownBackground": "#201f23",
    "settings.dropdownForeground": "#adadc0",
    "settings.dropdownBorder": "#2A2A37",
    "settings.textInputBackground": "#201f23",
    "settings.textInputForeground": "#adadc0",
    "settings.textInputBorder": "#2A2A37",
    "settings.focusedRowBackground": "#262628",
    "editorLineNumber.foreground": "#5d5d69",
    "editor.lineHighlightBackground": "#262628",
    "editor.inactiveLineHighlightBackground": "#201f23",
    "editor.lineHighlightBorder": "#262628",
    "editor.selectionHighlightBackground": "#00000000",
    "editor.selectionHighlightBorder": "#00000000",
    "editor.wordHighlightBackground": "#00000000",
    "editor.wordHighlightBorder": "#00000000",
    "editor.wordHighlightStrongBackground": "#00000000",
    "editor.wordHighlightStrongBorder": "#00000000",
    "editorSuggestWidget.background": "#201f23",
    "editorSuggestWidget.foreground": "#adadc0",
    "editorSuggestWidget.border": "#2A2A37",
    "editorSuggestWidget.selectedBackground": "#262628",
    "editorSuggestWidget.selectedForeground": "#DCD7BA",
    "editorHoverWidget.background": "#201f23",
    "editorHoverWidget.foreground": "#adadc0",
    "editorHoverWidget.border": "#2A2A37",
    "terminal.background": "#201f23",
    "terminal.foreground": "#DCD7BA",
    "terminalCursor.foreground": "#C8C093",
    "terminalCursor.background": "#201f23",
    "terminal.selectionBackground": "#2D4F67",
    "terminal.selectionForeground": "#DCD7BA",
    "terminal.inactiveSelectionBackground": "#223249",
    "terminal.ansiBlack": "#16161D",
    "terminal.ansiRed": "#C34043",
    "terminal.ansiGreen": "#76946A",
    "terminal.ansiYellow": "#C0A36E",
    "terminal.ansiBlue": "#7E9CD8",
    "terminal.ansiMagenta": "#957FB8",
    "terminal.ansiCyan": "#6A9589",
    "terminal.ansiWhite": "#DCD7BA",
    "terminal.ansiBrightBlack": "#727169",
    "terminal.ansiBrightRed": "#E46876",
    "terminal.ansiBrightGreen": "#98BB6C",
    "terminal.ansiBrightYellow": "#E6C384",
    "terminal.ansiBrightBlue": "#7FB4CA",
    "terminal.ansiBrightMagenta": "#938AA9",
    "terminal.ansiBrightCyan": "#7AA89F",
    "terminal.ansiBrightWhite": "#DCD7BA",
    "statusBar.debuggingForeground": "#ffffff"
  },

  // Security

  "security.workspace.trust.untrustedFiles": "open",

  // VSCodeVim

  "vim.leader": "<space>",

  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,

  "vim.foldfix": true,
  "vim.surround": true,
  "vim.sneak": true,
  "vim.sneakUseIgnorecaseAndSmartcase": true,

  "vim.camelCaseMotion.enable": false,
  "vim.statusBarColorControl": true,

  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 200,

  // VSCodeVim — Key Handling

  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-z>": false,
    "<C-w>": false,
    "<C-p>": false
  },

  // VSCodeVim — Insert Mode

  "vim.insertModeKeyBindings": [
    {
      "before": ["<C-c>"],
      "after": ["<Esc>"]
    }
  ],

  // VSCodeVim — Normal Mode

  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["shift", ";"],
      "commands": ["vim.showQuickpickCmdLine"],
      "when": "editorTextFocus && vim.mode != 'Insert'"
    },
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeActiveEditor"],
      "silent": true
    },
    {
      "before": ["<leader>", ";"],
      "commands": ["workbench.action.toggleStatusbarVisibility"],
      "silent": true
    },
    {
      "before": ["J"],
      "after": ["o", "<Esc>", "k", "$"]
    },
    {
      "before": ["K"],
      "after": ["O", "<Esc>", "j", "$"]
    },
    {
      "before": ["L"],
      "commands": ["lineBreakInsert"],
      "silent": true
    },
    {
      "before": ["z"],
      "commands": ["flash-vscode.start"]
    },
    {
      "before": ["F"],
      "commands": ["flash-vscode.startSelection"]
    },
    {
      "before": ["Z"],
      "commands": ["flash-vscode.jump.treesitterSelection"]
    },
    {
      "before": ["R"],
      "commands": ["flash-vscode.remoteTreesitterSelection"]
    },
    {
      "before": ["<BS>"],
      "commands": ["flash-vscode.backspace"]
    },
    {
      "before": ["<C-c>"],
      "commands": ["flash-vscode.exit"]
    },
    {
      "before": ["n"],
      "after": ["n", "z", "z", "z", "v"]
    },
    {
      "before": ["N"],
      "after": ["N", "z", "z", "z", "v"]
    },
    {
      "before": ["<C-d>"],
      "after": ["<C-d>", "z", "z"]
    },
    {
      "before": ["<C-u>"],
      "after": ["<C-u>", "z", "z"]
    },
    {
      "before": ["j"],
      "after": ["g", "j"]
    },
    {
      "before": ["k"],
      "after": ["g", "k"]
    },

    // Delete without changing the yank register
    {
      "before": ["<leader>", "x"],
      "after": ["\"", "_", "d"]
    },

    // Find and replace in the current editor
    {
      "before": ["<leader>", "s", "r"],
      "commands": ["editor.action.startFindReplaceAction"]
    },

    // Reindent paragraph and restore cursor
    {
      "before": ["<leader>", "a", "p"],
      "after": ["m", "a", "=", "a", "p", "`", "a"]
    },

    // Join lines and restore cursor
    {
      "before": ["J"],
      "after": ["m", "z", "J", "`", "z"]
    },

    // Next and previous editor tab
    {
      "before": ["[", "b"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["]", "b"],
      "commands": ["workbench.action.previousEditor"]
    },

    // Toggle word wrap
    {
      "before": ["<leader>", "k"],
      "commands": ["editor.action.toggleWordWrap"]
    },

    // Toggle whitespace rendering
    {
      "before": ["<leader>", "l"],
      "commands": ["toggleRenderWhitespace"]
    },

    // Expand syntax-aware selection
    {
      "before": ["="],
      "commands": ["editor.action.smartSelect.expand"]
    },
    {
      "before": ["<Backspace>"],
      "commands": ["editor.action.smartSelect.shrink"]
    }
  ],

  "vim.normalModeKeyBindings": [
    {
      "before": ["<leader>", "/"],
      "commands": [":nohl"]
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["£"],
      "after": ["#"]
    },
    {
      "before": ["<leader>", "f"],
      "commands": ["revealInExplorer"]
    },
    {
      "before": ["<leader>", "p", "a"],
      "commands": ["copyFilePath"]
    },

    // Focus editor groups
    {
      "before": ["<C-h>"],
      "commands": ["workbench.action.focusLeftGroup"]
    },
    {
      "before": ["<C-j>"],
      "commands": ["workbench.action.focusBelowGroup"]
    },
    {
      "before": ["<C-k>"],
      "commands": ["workbench.action.focusAboveGroup"]
    },
    {
      "before": ["<C-l>"],
      "commands": ["workbench.action.focusRightGroup"]
    },

    // Split editor
    {
      "before": ["<leader>", "s", "v"],
      "after": ["<C-w>", "v"]
    },
    {
      "before": ["<leader>", "s", "h"],
      "after": ["<C-w>", "s"]
    },

    // Git
    {
      "before": ["<leader>", "g", "p"],
      "commands": ["editor.action.dirtydiff.next"]
    },
    {
      "before": ["<leader>", "g", "r"],
      "commands": ["git.revertSelectedRanges"]
    },

    {
      "before": ["-"],
      "commands": ["workbench.files.action.focusFilesExplorer"],
      "silent": true
    }
  ],

  // VSCodeVim — Visual Mode

  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "p"],
      "after": ["p", "g", "v", "y"]
    },
    // Delete without yanking
    {
      "before": ["<leader>", "x"],
      "after": ["\"", "_", "d"]
    },

    // Indent and preserve selection
    {
      "before": ["<"],
      "after": ["<", "g", "v"]
    },
    {
      "before": [">"],
      "after": [">", "g", "v"]
    },

    // Expand and shrink syntax-aware selection
    {
      "before": ["="],
      "commands": ["editor.action.smartSelect.expand"]
    },
    {
      "before": ["<Backspace>"],
      "commands": ["editor.action.smartSelect.shrink"]
    }
  ],
  // Exit insert mode with Ctrl+C
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": ["<C-c>"],
      "after": ["<Esc>"]
    }
  ],

  "vim.visualModeKeyBindings": [
    {
      "before": ["<C-c>"],
      "after": ["<Esc>"]
    },
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesUpAction"]
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesDownAction"]
    }
  ],

  // VSCodeVim — macOS Input Method

  "vim.autoSwitchInputMethod.enable": true,
  "vim.autoSwitchInputMethod.defaultIM": "com.apple.keylayout.US",
  "vim.autoSwitchInputMethod.obtainIMCmd": "/usr/local/bin/im-select",
  "vim.autoSwitchInputMethod.switchIMCmd": "/usr/local/bin/im-select {im}",

  // Extensions

  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },

  "liveServer.settings.donotVerifyTags": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "workbench.editor.showTabs": "none",
  "workbench.colorTheme": "Kanagawa Wave",
  "workbench.editor.editorActionsLocation": "titleBar",
  "breadcrumbs.enabled": false,
  "workbench.statusBar.visible": false
}
