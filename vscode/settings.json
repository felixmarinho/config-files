    "textMateRules": [
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "foreground": "#687387"
        }
      },
      {
        "scope": "constant.language.json.comments",
        "settings": {
          "foreground": "#F78C6C",
          "fontStyle": ""
        }
      }
    ]
